let blocoEditando = null;

document.getElementById(
"criarCustom"
).onclick = () => {

  const titulo =
  document.getElementById(
  "tituloCustom"
  ).value.trim();

  if(!titulo) return;


  // =====================================
  // EDITAR
  // =====================================

  if(blocoEditando){

    blocoEditando.querySelector(
    ".tarefa-nome"
    ).innerText = titulo;

    blocoEditando.querySelector(
    ".tempo-texto"
    ).innerText =
    `⏱ ${horas}h`;

    blocoEditando.style.background =
    corSelecionada;

    blocoEditando.dataset.cor =
    corSelecionada;

    blocoEditando = null;

  }


  // =====================================
  // CRIAR
  // =====================================

  else{

    const tarefa =
    document.createElement("div");

   tarefa.classList.add(
"tarefa"
);

tarefa.classList.add(
"tarefa-custom"
);

    tarefa.style.background =
    corSelecionada;

    tarefa.dataset.cor =
    corSelecionada;


    tarefa.innerHTML = `

      <div class="tarefa-topo">

        <label class="check-area">

          <input
          type="checkbox"
          class="check-tarefa">

          <span class="check-custom"></span>

        </label>

        <div class="acoes-tarefa">

          <button class="btn-editar">
            ✏️
          </button>

          <button class="btn-remover">
            ✕
          </button>

        </div>

      </div>

      <div class="tarefa-conteudo">

        <div class="tarefa-tipo">
          CUSTOM
        </div>

        <div class="tarefa-nome">
          ${titulo}
        </div>

        <div class="tempo-texto">
          ⏱ ${horas}h
        </div>

      </div>

    `;


    const checkbox =
    tarefa.querySelector(
    ".check-tarefa"
    );

    checkbox.onchange = () => {

      if(checkbox.checked){

        tarefa.style.opacity =
        ".55";

        tarefa.style.transform =
        "scale(.97)";

        tarefa.querySelector(
        ".tarefa-nome"
        ).style.textDecoration =
        "line-through";

      }else{

        tarefa.style.opacity =
        "1";

        tarefa.style.transform =
        "scale(1)";

        tarefa.querySelector(
        ".tarefa-nome"
        ).style.textDecoration =
        "none";

      }

    };


    // =====================================
    // REMOVER
    // =====================================

    tarefa.querySelector(
    ".btn-remover"
    ).onclick = () => {

      const novoBotao =
      document.createElement(
      "button"
      );

      novoBotao.classList.add(
      "btn-add"
      );

      novoBotao.innerText =
      "+ Adicionar bloco";

      tarefa.replaceWith(
      novoBotao
      );

      ativarBotoesAdd();

    };


    // =====================================
    // EDITAR
    // =====================================

    tarefa.querySelector(
    ".btn-editar"
    ).onclick = () => {

      blocoEditando = tarefa;

      modalCustom.style.display =
      "flex";

      document.getElementById(
      "tituloCustom"
      ).value =
      tarefa.querySelector(
      ".tarefa-nome"
      ).innerText;

      const textoTempo =
      tarefa.querySelector(
      ".tempo-texto"
      ).innerText;

      horas =
      parseInt(
        textoTempo.replace(/\D/g, "")
      );

      if(isNaN(horas)){

        horas = 1;

      }

      tempoValor.innerText =
      `${horas}h`;

      corSelecionada =
      tarefa.dataset.cor;

      document
      .querySelectorAll(".cor-btn")
      .forEach(btn => {

        btn.classList.remove(
        "ativa"
        );

        if(
          btn.dataset.cor ===
          corSelecionada
        ){

          btn.classList.add(
          "ativa"
          );

        }

      });

    };


    // =====================================
    // SUBSTITUI BOTÃO
    // =====================================

    const botaoAtual =
    document.querySelector(
    ".btn-add.aberto"
    );

    if(botaoAtual){

      botaoAtual.replaceWith(
      tarefa
      );

    }

  }


  // =====================================
  // RESET
  // =====================================

  document.getElementById(
  "tituloCustom"
  ).value = "";

  horas = 1;

  tempoValor.innerText =
  "1h";


  // =====================================
  // FECHAR
  // =====================================

  modalCustom.style.display =
  "none";

  modalTipos.style.display =
  "none";

};












