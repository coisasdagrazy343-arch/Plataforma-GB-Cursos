let tempo = 0;
let rodando = false;
let intervalo;

const display = document.getElementById("timer-display");
const btnStart = document.getElementById("start-timer");
const btnPause = document.getElementById("pause-timer");
const btnReset = document.getElementById("reset-timer");

function atualizar() {
  let h = Math.floor(tempo / 3600);
  let m = Math.floor((tempo % 3600) / 60);
  let s = tempo % 60;

  display.innerText =
    String(h).padStart(2, "0") + ":" +
    String(m).padStart(2, "0") + ":" +
    String(s).padStart(2, "0");
}

btnStart.onclick = () => {
  if (rodando) return;

  rodando = true;
  intervalo = setInterval(() => {
    tempo++;
    atualizar();
  }, 1000);

  btnStart.disabled = true;
  btnPause.disabled = false;
  btnReset.disabled = false;
};

btnPause.onclick = () => {
  rodando = false;
  clearInterval(intervalo);
  btnStart.disabled = false;
  btnPause.disabled = true;
};

btnReset.onclick = () => {
  tempo = 0;
  rodando = false;
  clearInterval(intervalo);
  atualizar();

  btnStart.disabled = false;
  btnPause.disabled = true;
  btnReset.disabled = true;
};

atualizar();

