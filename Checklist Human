/* ===== DISCIPLINAS AULAS ===== */

.disciplinas-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(230px, 280px));
  gap: 25px;
  
   justify-content: center;
}

/* ===== CARD BASE ===== */

.card-disc {
  position: relative;
  height: 60/30;
  border-radius: 20px;

  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* organiza tudo embaixo */
  gap: 6px; /* espaço entre os elementos */

  padding: 18px;

  cursor: pointer;
  overflow: hidden;

  color: white;
  font-weight: 600;

  background-size: cover;        /* 🔥 aqui */
  background-position: center;   /* 🔥 aqui */
  background-repeat: no-repeat;  /* 🔥 aqui */

  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  transition: 0.3s;
}

/* OVERLAY ESCURO (PROFISSIONAL) */
.card-disc::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.85));
  z-index: 1;
}

/* GARANTE TEXTO NA FRENTE */
.card-disc * {
  position: relative;
  z-index: 2;
}

/* HOVER */
.card-disc:hover {
  transform: translateY(-6px) scale(1.02);
  box-shadow: 0 20px 50px rgba(139,92,246,0.4);
}

/* ===== TOPO ===== */

.card-top {
  display: flex;
  justify-content: space-between;
}

/* ÍCONE */
.icon-box {
  width: 60px;
  height: 60px;
  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

}

/* 👉 COLOCA ISSO LOGO ABAIXO */
.icon-box img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* ===== TEXTO ===== */

.card-disc h3 {
  margin-top: auto; /* 🔥 ISSO resolve */
  font-size: 18px;
}

.card-disc p {
  margin: 0;
  font-size: 13px;
  opacity: 0.85;
}

/* ===== PROGRESS BAR ===== */

.progress-bar {
  width: 100%;
  height: 6px;
  background: rgba(255,255,255,0.2);
  border-radius: 10px;
  overflow: hidden;
  margin-top: 4px;
}

.progress {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #22c55e, #4ade80);
}

/* ===== BOTÃO ===== */

.btn-card {
  margin-top: 8px;
  padding: 10px;
  border-radius: 10px;

  background: rgba(0,0,0,0.4);
  border: 1px solid rgba(255,255,255,0.2);

  color: white;
  font-weight: 600;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  cursor: pointer;
  transition: 0.25s;
}

.btn-card:hover {
  background: rgba(255,255,255,0.15);
}

/* ===== MODO CLARO ===== */

body.light .card-disc {
  color: white;
}

/* overlay mais suave (sem “lavar” a imagem) */
body.light .card-disc::after {
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.05),
    rgba(0,0,0,0.25)
  );
}

