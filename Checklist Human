<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Plataforma de Estudos</title>

  <!-- Fonte Poppins e Pacifico -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Pacifico&display=swap" rel="stylesheet">

 <style>
    /* Remove margens e padding antes de tudo */
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      font-family: 'Poppins', sans-serif;
    }

    body.light {
      background: linear-gradient(135deg, #e0e7ff, #f8fafc);
      color: #111827;
      transition: 0.4s;
    }

    body {
      background: linear-gradient(135deg, #0f172a, #020617);
      color: white;
      transition: 0.4s;
    }

    /* Banner full width no topo */
    .banner {
      position: relative;
      width: 100%;
      height: 400px;
      overflow: hidden;
      margin: 0;
      background-image: url('https://cdn.designfast.io/image/2026-04-26/471eb48f-0196-4803-b83e-b630f9e0ae94.png');
      background-size: cover;
      background-position: center;
      filter: brightness(1.2);
      box-shadow: 0 10px 95px rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
      z-index: 999;
    }

    .banner::after {
      content: "";
      position: absolute;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.45);
      z-index: 1;
    }

    .banner-text {
      position: relative;
      font-family: 'Pacifico', cursive;
      font-size: 48px;
      color: white;
      z-index: 2;
      text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8);
      user-select: none;
    }
    
  .banner-logo {
  position: absolute;
  top: 12px;
  left: 12px;
  width: 50px; /* ajuste o tamanho conforme necessário */
  height: auto;
  z-index: 3; /* acima do overlay */
  filter: brightness(0.7); /* diminui o brilho para 70% */
}
  

    /* Container delimita largura do conteúdo, margem automática, padding para dar espaçamento */
    .container {
      padding: 25px 40px;
      max-width: 1400px;
      margin: auto;
    }

    .shortcuts {
      display: flex;
      gap: 12px;
      margin-bottom: 30px;
      flex-wrap: wrap;
      user-select: none;
    }

body.light .shortcuts button:hover {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;

  transform: translateY(-2px);

  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}

.shortcuts button {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255,255,255,0.1);

  padding: 12px 18px;
  border-radius: 14px;

  color: inherit;
  cursor: pointer;
  font-weight: 600;

  flex: 1 1 140px;
  min-width: 120px;

  backdrop-filter: blur(10px);

  transition: all 0.25s ease;
}



body.light .shortcuts button {
  background: none;
  color: inherit;
}

.shortcuts button:hover {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 15px 5px rgba(240, 240, 255, 0.6);
  transition: background 0.3s, box-shadow 0.3s;
}

    h2 {
      margin-bottom: 15px;
    }

.welcome-box {
  background: #ddd6fe; /* lilás um pouco mais escuro */
  padding: 25px;
  border-radius: 18px;
  margin-bottom: 30px;
  text-align: center;
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
  user-select: none;
  color: #4c1d95;
  transition: 0.4s;
}

.welcome-box h1 {
  font-size: 28px;
  color: #6d28d9; /* ajustado pra combinar */
  margin-bottom: 8px;
}

.welcome-box p {
  opacity: .85;
  font-size: 16px;
  color: #5b21b6;
}

/* ===== MODO ESCURO - PAINEL INICIAL ===== */
body:not(.light) .welcome-box {
  background: linear-gradient(145deg, #1e293b, #0f172a);
  color: #e2e8f0;

  box-shadow: 
    0 10px 30px rgba(0,0,0,0.7),
    inset 0 1px 0 rgba(255,255,255,0.05);

  border: 1px solid rgba(167, 139, 250, 0.3); /* roxo suave */
}

/* TÍTULO EM ROXO */
body:not(.light) .welcome-box h1 {
  color: #a78bfa; /* roxo padrão */
}

/* TEXTO */
body:not(.light) .welcome-box p {
  color: #cbd5e1;
  opacity: 0.85;
}


    /* temporizador */
#temporizador {
  background: #0f172a; /* tom escuro do seu background */
  padding: 25px 30px;
  border-radius: 18px;
  max-width: 320px;
  margin: 40px auto;
  box-shadow: 0 6px 20px rgba(14, 23, 43, 0.8);
  color: #cbd5e1; /* cinza claro para texto */
  font-family: 'Poppins', sans-serif;
  text-align: center;
  user-select: none;
}

#timer-display {
  font-size: 3.8rem;
  font-weight: 700;
  letter-spacing: 3.5px;
  margin-bottom: 28px;
  color: #38bdf8; /* azul vibrante */
  text-shadow: 0 0 6px #0ea5e9aa;
}

#temporizador button {
  background: #1e293b;
  border: 1.5px solid #2563eb;
  color: #38bdf8;
  font-weight: 600;
  font-size: 1rem;
  padding: 10px 24px;
  margin: 0 8px;
  border-radius: 14px;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 2px 10px rgba(37, 99, 235, 0.3);
}

#temporizador button:disabled {
  background: #475569;
  border-color: #64748b;
  color: #94a3b8;
  cursor: not-allowed;
  box-shadow: none;
}

#temporizador button:hover:not(:disabled) {
  background: #2563eb;
  border-color: #1e40af;
  color: #e0f2fe;
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
  transform: translateY(-1.5px);
}













/* =========================
   PAINEL PROGRESSO
========================= */

.painel-progresso{
  display:flex;
  gap:18px;
  margin-top:24px;
  margin-bottom:24px;
  
  margin-left:-9px;
  
   width:100%;

  max-width:1400px;
  
}

.box-progresso{
  flex:6;
}

.box-nivel{
  flex:0.6;
}

/* =========================
   CARD
========================= */

.box-progresso{
  flex:1;
  min-width:180px;

  padding:22px;

  border-radius:24px;

  display:flex;
  flex-direction:column;
  gap:16px;

  position:relative;
  overflow:hidden;

  transition:0.35s ease;

  backdrop-filter:blur(12px);
}

/* brilho suave */
.box-progresso::before{
  content:"";

  position:absolute;
  inset:0;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      transparent 60%
    );

  pointer-events:none;
}

/* hover moderno */
.box-progresso:hover{
  transform:translateY(-4px);

  box-shadow:
    0 12px 30px rgba(0,0,0,.15);
}

/* =========================
   TOPO
========================= */

.box-progresso .topo{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

/* título */
.box-progresso .topo span:first-child{
  font-size:15px;
  font-weight:700;
  letter-spacing:-0.2px;
}

/* contador */
.box-progresso .topo span:last-child{
  font-size:15px;
  font-weight:800;
}

/* =========================
   BARRA
========================= */

.barra-progresso{
  width:100%;
  height:12px;

  border-radius:999px;

  overflow:hidden;

  position:relative;
}

.barra-progresso div{
  height:100%;
  width:0%;

  border-radius:999px;

  transition:width .5s ease;
}

/* =========================
   MODO ESCURO
========================= */

body:not(.light) .box-progresso{

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.05)
    );

  border:1px solid rgba(255,255,255,.10);

  color:#f1f5f9;

  box-shadow:
    0 10px 30px rgba(0,0,0,.35),
    inset 0 1px 0 rgba(255,255,255,.04);
}

/* fundo barra */
body:not(.light) .barra-progresso{
  background:rgba(255,255,255,.08);
}

/* aulas */
body:not(.light) #barra-aulas{
  background:
    linear-gradient(
      90deg,
      #8b5cf6,
      #6366f1
    );

  box-shadow:
    0 0 18px rgba(139,92,246,.5);
}

/* questões */
body:not(.light) #barra-questoes{
  background:
    linear-gradient(
      90deg,
      #22c55e,
      #4ade80
    );

  box-shadow:
    0 0 18px rgba(34,197,94,.45);
}

/* =========================
   MODO CLARO
========================= */

body.light .box-progresso{

  background:
    linear-gradient(
      180deg,
      #ffffff,
      #faf7ff
    );

  border:1px solid #ede9fe;

  color:#111827;

  box-shadow:
    0 10px 25px rgba(124,58,237,.08);
}

/* fundo barra */
body.light .barra-progresso{
  background:#ececf3;
}

/* aulas */
body.light #barra-aulas{
  background:
    linear-gradient(
      90deg,
      #8b5cf6,
      #6366f1
    );
}

/* questões */
body.light #barra-questoes{
  background:
    linear-gradient(
      90deg,
      #22c55e,
      #4ade80
    );
}

/* =========================
   LINHA INTERNA
========================= */

.linha-progresso{
  display:flex;
  align-items:center;
  gap:18px;
}

/* =========================
   ÍCONE
========================= */

.icone{
  min-width:64px;
  width:64px;
  height:64px;

  border-radius:50%;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:24px;

  flex-shrink:0;
}

/* aulas */
.icone.aulas{
  background:rgba(139,92,246,.12);
  color:#7c3aed;
}

/* questões */
.icone.questoes{
  background:rgba(34,197,94,.12);
  color:#22c55e;
}

/* =========================
   CONTEÚDO
========================= */

.conteudo-progresso{
  flex:1;

  display:flex;
  flex-direction:column;
  gap:10px;
}

/* descrição pequena */
.conteudo-progresso p{
  margin:0;

  font-size:14px;
  font-weight:500;

  opacity:.7;
}





/* ===== CARD MODERNO ===== */
.box-nivel {
  width: 220px;
  padding: 16px;
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);

  border: 1px solid rgba(255,255,255,0.4);

  box-shadow:
    0 8px 25px rgba(0,0,0,0.08),
    inset 0 1px 0 rgba(255,255,255,0.7);

  cursor: pointer;
  transition: all 0.3s ease;

  display: flex;
  flex-direction: column;
  gap: 12px;

  position: relative;
  overflow: hidden;
}

/* brilho suave */
.box-nivel::before {
  content: "";

  position: absolute;
  top: -50%;
  left: -30%;

  width: 180px;
  height: 180px;

  background: radial-gradient(
    rgba(255,255,255,0.7),
    transparent 70%
  );

  transform: rotate(20deg);
}

/* hover moderno */
.box-nivel:hover {
  transform: translateY(-5px);
  box-shadow:
    0 14px 35px rgba(0,0,0,0.12),
    inset 0 1px 0 rgba(255,255,255,0.9);
}

/* topo */
.nivel-topo {
  display: flex;
  justify-content: space-between;
  align-items: center;

  font-size: 13px;
  font-weight: 600;

  color: #1e293b;

  position: relative;
  z-index: 2;
}

/* ===== BADGE PRINCIPAL ===== */
.badge-atual {
  text-align: center;

  position: relative;
  z-index: 2;

  display: flex;
  justify-content: center;
  align-items: center;

  filter: drop-shadow(0 5px 10px rgba(0,0,0,0.15));
}

/* ================================================= */
/* AQUI VOCÊ ALTERA O TAMANHO DA IMAGEM DA BADGE */
/* width = largura */
/* height = altura */
/* ================================================= */

.badge-atual img {
  width: 180px;
  height: 170px;
  object-fit: contain;
}

/* texto do nível */
#nivel-atual-texto {
  background: #f1f5f9;
  padding: 4px 10px;
  border-radius: 999px;

  font-size: 12px;
  color: #475569;
}

/* ===== PAINEL (OVERLAY) ===== */
#painel-niveis {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;

  background: rgba(0,0,0,0.8);
  display: none;

  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.conteudo-niveis {
  background: #0f172a;
  padding: 20px;
  border-radius: 16px;
  width: 90%;
  max-width: 900px;
  color: white;
}

/* BOTÃO FECHAR */
.fechar {
  float: right;
  background: none;
  border: none;
  color: white;
  font-size: 18px;
  cursor: pointer;
}

/* GRID */
.grid-niveis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 15px;
}

/* BADGES */
.badge-nivel {
  background: #1e293b;
  border-radius: 12px;
  padding: 10px;

  text-align: center;
  font-size: 20px;

  display: flex;
  flex-direction: column;
  align-items: center;

  transition: 0.3s;
}

/* TEXTO */
.badge-nivel span {
  font-size: 11px;
}

.badge-nivel small {
  font-size: 10px;
  opacity: 0.6;
}

/* BLOQUEADO */
.bloqueado {
  opacity: 0.3;
  filter: grayscale(1);
}

/* DESBLOQUEADO */
.desbloqueado {
  border: 2px solid #22c55e;
}

/* ATUAL */
.atual {
  transform: scale(1.1);
  box-shadow: 0 0 10px #22c55e;
}





























/* ===================================================== */
/* QUESTÕES • ESTILO PREMIUM EXCLUSIVO */
/* ===================================================== */

#listas{
  padding: 10px 0 35px;
}

/* ===== TOPO ===== */

.titulo-listas{
  font-size: 30px;
  font-weight: 800;
  color: #f8fafc;
  margin-bottom: 6px;
}

.sub-listas{
  color: #94a3b8;
  font-size: 15px;
  margin-bottom: 28px;
}

/* ===================================================== */
/* GRID */
/* ===================================================== */

.grid-questoes{
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(270px,1fr));
  gap: 22px;
}

/* ===================================================== */
/* CARD BASE */
/* ===================================================== */

.card-q{
  position: relative;
  overflow: hidden;

  border-radius: 26px;

  padding: 24px;

  min-height: 250px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  transition: .35s ease;

  isolation: isolate;

  border: 1px solid rgba(255,255,255,.08);

  backdrop-filter: blur(12px);
}

/* ===================================================== */
/* CORES DAS DISCIPLINAS */
/* ===================================================== */

.card-q.matematica{
  background: linear-gradient(160deg,#16213e 0%,#2563eb 100%);
}

.card-q.fisica{
  background: linear-gradient(160deg,#2a1b3d 0%,#ff5f45 100%);
}

.card-q.biologia{
  background: linear-gradient(160deg,#10261c 0%,#16a34a 100%);
}

.card-q.quimica{
  background: linear-gradient(160deg,#25103b 0%,#9333ea 100%);
}

.card-q.linguagens{
  background: linear-gradient(160deg,#3b1c12 0%,#f97316 100%);
}

.card-q.historia{
  background: linear-gradient(160deg,#3a2614 0%,#f59e0b 100%);
}

.card-q.geografia{
  background: linear-gradient(160deg,#0f2d37 0%,#06b6d4 100%);
}

.card-q.filosofia{
  background: linear-gradient(160deg,#3a1326 0%,#ec4899 100%);
}

.card-q.sociologia{
  background: linear-gradient(160deg,#2d1f49 0%,#8b5cf6 100%);
}

/* ===================================================== */
/* EFEITO DECORATIVO */
/* ===================================================== */

.card-q::before{
  content:"";
  position:absolute;

  width:280px;
  height:280px;

  border-radius:50%;

  top:-120px;
  right:-120px;

  background: rgba(255,255,255,.08);

  filter: blur(2px);
}

/* LINHA BRILHANTE */

.card-q::after{
  content:"";
  position:absolute;

  inset:0;

  background:
  linear-gradient(
    120deg,
    transparent 20%,
    rgba(255,255,255,.07),
    transparent 80%
  );

  transform: translateX(-100%);

  transition: .8s;
}

/* ===================================================== */
/* HOVER */
/* ===================================================== */

.card-q:hover{
  transform: translateY(-7px);
}

.card-q:hover::after{
  transform: translateX(100%);
}

/* ===================================================== */
/* TOPO CARD */
/* ===================================================== */

.top-card{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
}

/* ===================================================== */
/* ÍCONE */
/* ===================================================== */

.card-q .icon{
  width:68px;
  height:68px;

  border-radius:20px;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:32px;

  background: rgba(255,255,255,.12);

  border: 1px solid rgba(255,255,255,.12);

  color:#fff;

  backdrop-filter: blur(8px);
}

/* ===================================================== */
/* TAG */
/* ===================================================== */

.card-q .tag{
  padding: 8px 14px;

  border-radius: 999px;

  background: rgba(255,255,255,.1);

  color: rgba(255,255,255,.88);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: .5px;
}

/* ===================================================== */
/* TEXTO */
/* ===================================================== */

.card-q h3{
  font-size: 30px;
  line-height: 1.05;

  margin: 22px 0 10px;

  color: #fff;

  font-weight: 800;
}

.card-q p{
  color: rgba(255,255,255,.78);

  font-size: 14px;
  line-height: 1.6;

  margin-bottom: 22px;
}

/* ===================================================== */
/* FOOTER */
/* ===================================================== */

.bottom-card{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
}

/* QUESTÕES */

.qtd{
  color: rgba(255,255,255,.92);

  font-size: 14px;
  font-weight: 600;
}

/* BOTÃO */

.card-q button{
  border:none;

  height:46px;

  padding:0 22px;

  border-radius:14px;

  background:#fff;

  color:#0f172a;

  font-weight:800;

  cursor:pointer;

  transition:.25s;
}

.card-q button:hover{
  transform: scale(1.05);
}

/* ===================================================== */
/* LIGHT MODE */
/* ===================================================== */

body.light .titulo-listas{
  color:#111827;
}

body.light .sub-listas{
  color:#6b7280;
}

.card-q.revisoes-globais {
  background: linear-gradient(160deg, #1f2937 0%, #2563eb 100%);
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 8px 30px rgba(37, 99, 235, 0.4);
  border-radius: 26px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: white;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.card-q.revisoes-globais:hover {
  transform: translateY(-8px) scale(1.03);
  box-shadow: 0 12px 45px rgba(37, 99, 235, 0.7);
}

.card-q.revisoes-globais .icon {
  font-size: 36px;
  background: rgba(255, 255, 255, 0.15);
  padding: 12px;
  border-radius: 18px;
  box-shadow: 0 2px 15px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.card-q.revisoes-globais h3 {
  margin-top: 20px;
  font-size: 28px;
  font-weight: 900;
  letter-spacing: 0.03em;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
}

.card-q.revisoes-globais p {
  font-size: 15px;
  opacity: 0.85;
  margin: 10px 0 30px 0;
  line-height: 1.4;
}

.card-q.revisoes-globais .qtd {
  font-weight: 700;
  font-size: 15px;
  color: #a5b4fc;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
}

.card-q.revisoes-globais button {
  background: white;
  border: none;
  padding: 14px 28px;
  border-radius: 20px;
  font-weight: 700;
  cursor: pointer;
  color: #2563eb;
  font-size: 16px;
  transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
}

.card-q.revisoes-globais button:hover {
  background: #2563eb;
  color: white;
  box-shadow: 0 6px 25px rgba(59, 130, 246, 0.7);
}

















/* ===== PLANNER GERAL ===== */

#planner {
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  padding: 20px 10px;
  overflow-x: hidden;
}

/* CONTAINER PRINCIPAL */

.planner-container {
  display: flex;
  gap: 18px;
  align-items: flex-start;
  width: 100%;
}

/* ===== LADO ESQUERDO ===== */

.lado-esquerdo {
  width: 170px;
  min-width: 170px;

  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* BOTÕES */

#btn-semanal,
#btn-mensal,
#btn-radar {

  background: #1e293b;
  color: #38bdf8;

  border: 1.5px solid #2563eb;

  padding: 10px;

  border-radius: 10px;

  cursor: pointer;

  font-weight: 600;

  transition: 0.25s;
}

#btn-semanal:hover,
#btn-mensal:hover,
#btn-radar:hover {

  background: #2563eb;
  color: white;
}

/* CONTEÚDOS */

.conteudos {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.item {
  padding: 10px;
  border-radius: 10px;
  cursor: grab;
  font-weight: 600;
  color: white;
  user-select: none;
}

/* ===================================== */
/* SEMANA */
/* ===================================== */

.semana {

  display: grid;

  grid-template-columns:
    repeat(7, minmax(150px, 1fr));

  gap: 10px;

  flex: 1;

  width: 100%;

  overflow-x: auto;
}

/* ===================================== */
/* DIAS */
/* ===================================== */

.dia {

  min-width: 150px;

  min-height: 300px;

  background: #0f172a;

  border: 1px solid rgba(255,255,255,0.04);

  border-radius: 18px;

  padding: 10px;

  display: flex;

  flex-direction: column;

  gap: 10px;

  position: relative;

  transition: 0.25s;
}

/* ===================================== */
/* TOPO DO DIA */
/* ===================================== */

.dia-topo {

  width: 100%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 2px;
}

.nome-dia {

  font-size: 12px;
  font-weight: 700;
}

.data-dia {

  font-size: 10px;
  opacity: 0.7;
}

/* ===================================== */
/* BOTÃO ADICIONAR */
/* ===================================== */

.btn-add {

  width: 100%;
  height: 74px;

  border-radius: 12px;

  border: 2px dashed rgba(255,255,255,0.08);

  background: rgba(255,255,255,0.02);

  color: #94a3b8;

  font-size: 11px;
  font-weight: 700;

  cursor: pointer;

  transition: 0.25s;

  display: flex;
  justify-content: center;
  align-items: center;

  text-align: center;
}

.btn-add:hover {

  background: rgba(59,130,246,0.12);
  border-color: #3b82f6;
  color: white;
}

body.light .btn-add {

  border: 2px dashed #d1d5db;
  background: #f8fafc;
  color: #64748b;
}

body.light .btn-add:hover {

  background: #dbeafe;
  border-color: #2563eb;
  color: #2563eb;
}

/* ===================================== */
/* TAREFAS */
/* ===================================== */

.tarefa {

  width: 100%;

  padding: 10px;

  border-radius: 12px;

  background: linear-gradient(
    135deg,
    #1e293b,
    #0f172a
  );

  border: 1px solid rgba(255,255,255,0.05);

  display: flex;
  flex-direction: column;
  gap: 6px;

  transition: 0.25s;

  overflow: hidden;
}

body.light .tarefa {

  background: white;
  border: 1px solid #e5e7eb;
}

.tarefa:hover {
  transform: scale(1.02);
}

.tarefa-tipo {

  font-size: 10px;
  font-weight: 700;

  color: #60a5fa;
}

.tarefa-nome {

  font-size: 11px;
  font-weight: 600;

  line-height: 1.3;

  word-break: break-word;
}

/* ===================================== */
/* ITEM CONCLUÍDO */
/* ===================================== */

.item-concluido {

  opacity: 0.5;
  text-decoration: line-through;
  transform: scale(0.95);
}

/* ===================================== */
/* MENSAL */
/* ===================================== */

.mensal {

  display: grid;

  grid-template-columns:
    repeat(5, minmax(220px, 1fr));

  gap: 24px;

  margin-top: 20px;

  width: 100%;
}

.mes {

  min-height: 180px;

  background: #1e293b;

  border-radius: 12px;

  padding: 10px;

  font-weight: 600;

  display: flex;
  flex-direction: column;
  gap: 6px;

  transition: 0.3s;
}

.mes:hover {
  transform: scale(1.02);
}

body.light .mes {

  background: #e2e8f0;
  color: #111827;
}

/* ===================================== */
/* RADAR */
/* ===================================== */

.radar-container {

  display: flex;
  gap: 20px;

  margin-top: 20px;

  width: 100%;
}

.radar-lista {

  width: 220px;

  background: #1e293b;

  padding: 10px;

  border-radius: 10px;
}

.radar-colunas {

  display: flex;
  gap: 15px;

  flex: 1;
}

.coluna {

  flex: 1;

  background: #1e293b;

  padding: 10px;

  border-radius: 10px;

  min-height: 300px;
}

.coluna h4 {
  margin-bottom: 10px;
}

.radar-item {

  background: #334155;

  padding: 8px;

  border-radius: 8px;

  margin-bottom: 6px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}





/* ===================================== */
/* MODAL TIPOS */
/* ===================================== */

.modal-tipos{

  position:fixed;

  inset:0;

  background:rgba(0,0,0,.45);

  display:none;

  justify-content:center;

  align-items:center;

  z-index:9999;

  backdrop-filter:blur(6px);
}


/* BOX */

.modal-box{

  width:430px;

  background:white;

  border-radius:28px;

  padding:24px;

  animation:surgir .25s ease;

  box-shadow:
  0 10px 40px rgba(0,0,0,.12);
