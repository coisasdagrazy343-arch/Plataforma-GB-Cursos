// =====================================
// DRAG MENSAL
// =====================================

document.querySelectorAll(".mes")
.forEach(mes => {

  mes.addEventListener(
    "dragover",
    e => e.preventDefault()
  );

  mes.addEventListener(
    "drop",
    () => {

      if(!itemArrastado) return;

      const novo =
      itemArrastado.cloneNode(true);

      novo.style.background =
      itemArrastado.dataset.cor;

      novo.style.color =
      "white";

      const check =
      document.createElement("input");

      check.type = "checkbox";

      check.style.marginRight =
      "6px";

      check.onchange = function(){

        if(this.checked){

          novo.classList.add(
          "item-concluido"
          );

        }else{

          novo.classList.remove(
          "item-concluido"
          );

        }

      };

      const btnX =
      document.createElement("span");

      btnX.innerText = " ✕";

      btnX.style.cursor =
      "pointer";

      btnX.style.marginLeft =
      "6px";

      btnX.onclick = () => {

        novo.remove();

      };

      novo.innerHTML = "";

      novo.appendChild(check);

      novo.appendChild(
        document.createTextNode(
          itemArrastado.innerText
        )
      );

      novo.appendChild(btnX);

      mes.appendChild(novo);

    }
  );

});


