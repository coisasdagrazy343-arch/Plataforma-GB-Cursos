  font-size:16px;

  font-weight:700;

  cursor:pointer;

  transition:.25s;
}

.btn-criar:hover{

  transform:translateY(-2px);
}


/* ===================================== */
/* ANIMAÇÃO */
/* ===================================== */

@keyframes surgir{

  from{

    opacity:0;

    transform:scale(.92);
  }

  to{

    opacity:1;

    transform:scale(1);
  }

}


