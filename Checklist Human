/* =========================
   CHECKlIST
========================= */
let abaAnterior = null;

function abrirChecklist() {

  // Esconder abas principais
  const abas = [
    'inicio',
    'disciplinas',
    'listas',
    'revisoes',
    'planner',
    'temporizador'
  ];

  abaAnterior = abas.find(id => {
    const el = document.getElementById(id);
    return el && (
      el.style.display === 'block' ||
      getComputedStyle(el).display !== 'none'
    );
  }) || 'inicio';

  abas.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.style.display = 'none';
    }
  });

  const checklist = document.getElementById('checklist');
  if (checklist) {
    checklist.style.display = 'block';
  }

  // Esconder atalhos
  const shortcuts = document.querySelector('.shortcuts');
  if (shortcuts) {
    shortcuts.style.display = 'none';
  }

}

document
  .getElementById('btn-voltar-checklist')
  .addEventListener('click', () => {

    document.getElementById('checklist').style.display = 'none';

    // Mostrar atalhos novamente
    const shortcuts = document.querySelector('.shortcuts');
    if (shortcuts) {
      shortcuts.style.display = 'flex';
    }

    if (abaAnterior) {
      const el = document.getElementById(abaAnterior);
      if (el) {
        el.style.display = 'block';
      }
    }

  });

function abrirChecklistMateria(materia) {

  document
    .querySelectorAll(".checklist-disciplina")
    .forEach(secao => {
      secao.style.display = "none";
    });

  document
    .getElementById("checklist-" + materia)
    .style.display = "block";

}

function atualizarBarra(card) {

  const checks =
    card.querySelectorAll("input[type='checkbox']");

  const barra =
    card.querySelector(".barra-fill");

  const total = checks.length;

  const marcados =
    card.querySelectorAll(
      "input[type='checkbox']:checked"
    ).length;

  const progresso =
    (marcados / total) * 100;

  barra.style.width = progresso + "%";

}

// SALVAR CHECKBOXES
document.addEventListener("change", function (e) {

  if (e.target.matches("input[type='checkbox']")) {

    const todosChecks = [
      ...document.querySelectorAll("input[type='checkbox']")
    ];

    const indice = todosChecks.indexOf(e.target);

    localStorage.setItem(
      "check_" + indice,
      e.target.checked
    );

    const card = e.target.closest(".macro-card");

    if (card) {
      atualizarBarra(card);
    }

  }

});

// CARREGAR CHECKBOXES SALVOS
window.addEventListener("DOMContentLoaded", () => {

  const todosChecks =
    document.querySelectorAll("input[type='checkbox']");

  todosChecks.forEach((check, indice) => {

    const salvo =
      localStorage.getItem("check_" + indice);

    if (salvo !== null) {
      check.checked = (salvo === "true");
    }

  });

  // Atualizar todas as barras
  document
    .querySelectorAll(".macro-card")
    .forEach(card => {
      atualizarBarra(card);
    });

});




















/* =========================
   METAS DIÁRIAS
========================= */

document.addEventListener("DOMContentLoaded", () => {

    /* ELEMENTOS */

    const abrirMetas =
    document.getElementById("abrirMetas");

    const modalMetas =
    document.getElementById("modalMetas");

    const fecharModal =
    document.getElementById("fecharModal");

    const painelMeta =
    document.getElementById("painelMeta");


    /* VERIFICAÇÃO */

    if(
        !abrirMetas ||
        !modalMetas ||
        !fecharModal ||
        !painelMeta
    ){
        console.error("Elementos não encontrados.");
        return;
    }


    /* META */

    let metaAtual = null;


    /* =========================
       ABRIR MODAL
    ========================= */

    abrirMetas.addEventListener("click", () => {

        modalMetas.style.display = "flex";

    });


    /* =========================
       FECHAR MODAL
    ========================= */

    fecharModal.addEventListener("click", () => {

        modalMetas.style.display = "none";

    });


    /* FECHAR CLICANDO FORA */

    modalMetas.addEventListener("click", (e) => {

        if(e.target === modalMetas){

            modalMetas.style.display = "none";
        }

    });


    /* =========================
       SELECIONAR META
    ========================= */

    window.selecionarMeta = function(
        nome,
        aulasMeta,
        questoesMeta
    ){

        metaAtual = {

            nome,

            aulasMeta,

            questoesMeta,

            aulasFeitas:0,

            questoesFeitas:0
        };


        modalMetas.style.display =
        "none";


        renderizarMeta();

    }


    /* =========================
       RENDERIZAR
    ========================= */

    function renderizarMeta(){

        const aulasPercent =

        (metaAtual.aulasFeitas /
        metaAtual.aulasMeta) * 100;


        const questoesPercent =

        (metaAtual.questoesFeitas /
        metaAtual.questoesMeta) * 100;


        painelMeta.innerHTML = `

            <div class="meta-card">

                <div class="meta-titulo">

                    <h3>${metaAtual.nome}</h3>

                </div>


                <!-- AULAS -->

                <div class="meta-item">

                    <div class="meta-info">

                        <span>Aulas</span>

                        <span>

                        ${metaAtual.aulasFeitas}/${metaAtual.aulasMeta}

                        </span>

                    </div>


                    <div class="progress">

                        <div
                        class="progress-fill blue"
                        style="width:${aulasPercent}%">
                        </div>

                    </div>

                </div>


                <!-- QUESTÕES -->

                <div class="meta-item">

                    <div class="meta-info">

                        <span>Questões</span>

                        <span>

                        ${metaAtual.questoesFeitas}/${metaAtual.questoesMeta}

                        </span>

                    </div>


                    <div class="progress">

                        <div
                        class="progress-fill pink"
                        style="width:${questoesPercent}%">
                        </div>

                    </div>

                </div>

            </div>

        `;

    }


    /* =========================
       FUNÇÕES FUTURAS
    ========================= */

    window.atualizarAulasMeta = function(valor){

        if(!metaAtual) return;

        metaAtual.aulasFeitas = valor;

        renderizarMeta();

    }


    window.atualizarQuestoesMeta = function(valor){

        if(!metaAtual) return;

        metaAtual.questoesFeitas = valor;

        renderizarMeta();

    }

});

















