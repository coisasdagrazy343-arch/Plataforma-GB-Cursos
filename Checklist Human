function renderizarAssuntos(){

  listaAssuntos.innerHTML = "";

  const assuntos =
  assuntosPorMateria[
    materiaSelecionada
  ] || [];

  assuntos.forEach(assunto => {

    const div =
    document.createElement("div");

    div.classList.add(
    "opcao-materia"
    );

    div.innerText =
    assunto;

    div.onclick = () => {

      assuntoSelecionado =
      assunto;

      assuntoSelecionadoTexto.innerText =
      assunto;

      listaAssuntos.style.display =
      "none";

    };

    listaAssuntos.appendChild(
    div
    );

  });

}


