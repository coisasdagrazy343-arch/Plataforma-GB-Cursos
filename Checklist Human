/* ==========================================================
   PÁGINA DA MATÉRIA
========================================================== */

#pagina-materia{
    display:none;
    margin-top:35px;
}


/* ==========================================================
   TOPO DA PÁGINA
========================================================== */

.top-materia{

    display:flex;

    align-items:center;

    gap:20px;

    margin-bottom:30px;

}

#tituloMateria{

    font-size:34px;

    font-weight:700;

    color:#111827;

}

.btn-voltar{

    border:none;

    background:#4361ee;

    color:#fff;

    padding:12px 22px;

    border-radius:12px;

    cursor:pointer;

    font-weight:600;

    transition:.25s;

}

.btn-voltar:hover{

    transform:translateY(-2px);

    background:#3153ea;

}


/* ==========================================================
   CATEGORIAS
========================================================== */

.category-card{

    background:#ffffff;

    border:1px solid #ececec;

    border-radius:22px;

    margin-bottom:25px;

    overflow:hidden;

    transition:.3s;

    box-shadow:0 5px 18px rgba(0,0,0,.05);

}

.category-card:hover{

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}


/* ==========================================================
   CABEÇALHO
========================================================== */

.category-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:28px;

    cursor:pointer;

}

.category-left{

    display:flex;

    align-items:center;

    gap:22px;

}


/* ==========================================================
   ÍCONE
========================================================== */

.category-icon{

    width:82px;

    height:82px;

    border-radius:22px;

    background:#EEF3FF;

    display:flex;

    justify-content:center;

    align-items:center;

    overflow:hidden;

}

.category-icon img{

    width:70px;

}


/* ==========================================================
   TÍTULOS
========================================================== */

.category-title{

    font-size:30px;

    font-weight:700;

    color:#101828;

}

.category-count{

    margin-top:8px;

    display:inline-block;

    background:#EEF2FF;

    color:#4361ee;

    padding:5px 14px;

    border-radius:25px;

    font-size:13px;

    font-weight:600;

}


/* ==========================================================
   BOTÃO DA SETA
========================================================== */

.category-arrow{

    width:50px;

    height:50px;

    border-radius:50%;

    background:#fff;

    border:1px solid #ececec;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:22px;

    transition:.35s;

}

.category-card.open .category-arrow{

    transform:rotate(180deg);

}


/* ==========================================================
   ÁREA DOS DECKS
========================================================== */

.category-content{

    display:none;

    padding:25px;

    border-top:1px solid #ECECEC;

}

.category-card.open .category-content{

    display:block;

}


/* ==========================================================
   GRID
========================================================== */

.deck-grid{

    display:grid;

    grid-template-columns:repeat(auto-fill,minmax(250px,1fr));

    gap:24px;

}


/* ==========================================================
   CARD
========================================================== */

.deck-card{

    background:#fff;

    border-radius:18px;

    border:1px solid #ECECEC;

    overflow:hidden;

    cursor:pointer;

    transition:.25s;

}

.deck-card:hover{

    transform:translateY(-6px);

    box-shadow:0 15px 35px rgba(0,0,0,.10);

}


/* ==========================================================
   IMAGEM
========================================================== */

.deck-thumb{

    width:100%;

    height:150px;

    background:#f7f8fb;

    display:flex;

    justify-content:center;

    align-items:center;

}

.deck-thumb img{

    width:100%;

    height:100%;

    object-fit:cover;

}


/* ==========================================================
   TEXTO
========================================================== */

.deck-body{

    padding:18px;

}

.deck-title{

    font-size:18px;

    font-weight:700;

    color:#101828;

    margin-bottom:8px;

}

.deck-desc{

    color:#667085;

    font-size:14px;

    line-height:1.5;

}


/* ==========================================================
   RESPONSIVO
========================================================== */

@media(max-width:900px){

.deck-grid{

grid-template-columns:repeat(auto-fill,minmax(200px,1fr));

}

.category-title{

font-size:24px;

}

.category-icon{

width:65px;

height:65px;

}

}


@media(max-width:600px){

.top-materia{

flex-direction:column;

align-items:flex-start;

}

.category-header{

padding:20px;

}

.category-title{

font-size:20px;

}

.category-left{

gap:15px;

}

.deck-grid{

grid-template-columns:1fr;

}

}














