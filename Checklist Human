  margin-bottom:22px;

  color:#111827;
}


/* GRID */

.tipos-grid{

  display:grid;

  grid-template-columns:
  repeat(2,1fr);

  gap:14px;
}


/* BOTÃO */

.tipo-btn{

  height:110px;

  border:none;

  border-radius:22px;

  background:#F8FAFC;

  border:1px solid #E5E7EB;

  cursor:pointer;

  font-size:15px;

  font-weight:700;

  color:#111827;

  transition:.25s;
}

.tipo-btn:hover{

  transform:translateY(-3px);

  background:#2563EB;

  color:white;
}


/* ===================================== */
/* MODAL CUSTOM */
/* ===================================== */

.modal-customizar{

  position:fixed;

  inset:0;

  background:rgba(0,0,0,.45);

  display:none;

  justify-content:center;

  align-items:center;

