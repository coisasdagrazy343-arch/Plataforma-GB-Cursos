function atualizarPainelHoje(){

  const container =
  document.getElementById(
    "atividades-hoje"
  );

  if(!container) return;

  container.innerHTML = "";

  const hoje =
  new Date().getDay();

  const dias = [
    "Domingo",
    "Segunda-feira",
    "Terça-feira",
    "Quarta-feira",
    "Quinta-feira",
    "Sexta-feira",
    "Sábado"
  ];

  const diaHoje =
  document.getElementById(
    "dia-hoje"
  );

  if(diaHoje){

    diaHoje.textContent =
    dias[hoje];

  }

  let indicePlanner;

  switch(hoje){

    case 1:
      indicePlanner = 0;
      break;

    case 2:
      indicePlanner = 1;
      break;

    case 3:
      indicePlanner = 2;
      break;

    case 4:
      indicePlanner = 3;
      break;

    case 5:
      indicePlanner = 4;
      break;

    case 6:
      indicePlanner = 5;
      break;

    case 0:
      indicePlanner = 6;
      break;

  }

  const colunaHoje =
  document.querySelectorAll(
    ".dia"
  )[indicePlanner];

  if(!colunaHoje){

    container.innerHTML = `

      <div class="hoje-vazio">
        Nenhuma atividade.
      </div>

    `;

    return;

  }

  const tarefas =
  colunaHoje.querySelectorAll(
    ".tarefa"
  );

  if(tarefas.length === 0){

    container.innerHTML = `

      <div class="hoje-vazio">
        Nada planejado para hoje.
      </div>

    `;

    return;

  }

  tarefas.forEach(tarefa => {

    const card =
    document.createElement(
      "div"
    );

    card.classList.add(
      "item-hoje"
    );

    card.style.background =
    tarefa.dataset.cor ||
    "#2563EB";

    const tipo =
    tarefa.querySelector(
      ".tarefa-tipo"
    )?.innerText ||
    "ATIVIDADE";

    const nome =
    tarefa.querySelector(
      ".tarefa-nome"
    )?.innerText ||
    "Sem nome";

    const tempo =
    tarefa.querySelector(
      ".tempo-texto"
    )?.innerText ||
    "";

    const checkOriginal =
    tarefa.querySelector(
      ".check-tarefa"
    );

    const concluida =
    checkOriginal?.checked;

    const idCheck =
    "hoje-" +
    Math.random()
    .toString(36)
    .substring(2,9);

    card.innerHTML = `

      <div class="hoje-topo">

        <span class="hoje-tipo">
          ${tipo}
        </span>

        <label class="check-hoje-area">

          <input
            type="checkbox"
            class="check-hoje"
            id="${idCheck}"
            ${concluida ? "checked" : ""}
          >

          <span class="check-hoje-custom"></span>

        </label>

      </div>

      <div class="hoje-nome">
        ${nome}
      </div>

      <div class="hoje-tempo">
        ${tempo}
      </div>

    `;

    if(concluida){

      card.classList.add(
        "hoje-concluida"
      );

    }

    container.appendChild(
      card
    );

    const checkHoje =
    card.querySelector(
      ".check-hoje"
    );

    checkHoje.onchange = () => {

      if(!checkOriginal) return;

      checkOriginal.checked =
      checkHoje.checked;

      checkOriginal.dispatchEvent(
        new Event("change")
      );

      atualizarPainelHoje();

    };

  });

}



