/* ================= CALCULAR NÍVEL ================= */
function calcularNivel(questoes) {
  let nivel = 0;

  for (let i = 0; i < niveis.length; i++) {
    if (questoes >= niveis[i].min) {
      nivel = i;
    }
  }

  return nivel;
}


/* ================= ATUALIZAR UI ================= */
function atualizarNivel(questoes) {

  const badges = document.querySelectorAll(".badge-nivel");
  const badgeAtual = document.getElementById("badge-atual");
  const textoNivel = document.getElementById("nivel-atual-texto");

  const nivel = calcularNivel(questoes);

  /* RESET */
  badges.forEach(b => {
    b.classList.remove("desbloqueado", "bloqueado", "atual");
  });

  /* LOOP BADGES */
  badges.forEach((badge, index) => {

    if (index <= nivel) {
      badge.classList.add("desbloqueado");
    } else {
      badge.classList.add("bloqueado");
    }

    if (index === nivel) {
      badge.classList.add("atual");
    }
  });

  /* ATUALIZAR CARD PRINCIPAL */
  badgeAtual.innerHTML = niveis[nivel].icone;

  if (nivel === 0) {
    textoNivel.innerText = "Nível 0 • Iniciante";
  } else {
    textoNivel.innerText = `Nível ${nivel} • ${niveis[nivel].nome}`;
  }
}


